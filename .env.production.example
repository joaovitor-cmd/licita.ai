# Copie para .env.production na EC2. Nunca versione credenciais.
RELEASE_TAG=initial
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
# Opcional: CA do provedor em deploy/secrets/database-ca.pem
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=6
SMTP_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
# UUID de conta existente e conferida, somente para bootstrap inicial.
PLATFORM_ADMIN_USER_ID=
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=60
