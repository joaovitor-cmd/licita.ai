# Copie para .env e altere credenciais antes de publicar. Nunca comite o .env.
DATABASE_URL=postgresql://licita:licita@localhost:5432/licita
PORT=3000
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Coleta periódica opcional. Continua somente enquanto o backend estiver ligado.
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=60
# E-mails locais são capturados no Mailpit, não enviados para a internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Licita <nao-responda@licita.local>
# UUID de uma conta existente, verificada pelo operador. Nunca conceder por e-mail autodeclarado.
PLATFORM_ADMIN_USER_ID=
# Console independente (processo/API e frontend próprios). Produção exige origem HTTPS separada.
CONSOLE_PORT=3001
CONSOLE_API_HOST=127.0.0.1
CONSOLE_ORIGIN=http://localhost:5174
# Produção: chave aleatória de 32 bytes em Base64, gerida pelo operador. Não compartilhar.
# Desenvolvimento: quando vazia, uma chave local é criada em .local/smtp-key.bin.
SMTP_ENCRYPTION_KEY=
